class Solution {
    public int maxProfit(int[] prices) {
        int max=0;
        int minPrice=Integer.MAX_VALUE;
        for(int p:prices){
            if(p<minPrice){
                minPrice=p;
            }else if(p-minPrice>max){
                max=p-minPrice;
            }
        }
        return max;
    }
}
